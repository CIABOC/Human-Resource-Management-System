# Copy to .env and set real values. Never commit .env.

# Profile: "prod" for UAT/production. "dev" adds demo data, demo users (password Demo@12345) and on-screen OTP.
SPRING_PROFILES_ACTIVE=prod

PUBLIC_ORIGIN=https://localhost
HTTP_PORT=80
HTTPS_PORT=443

DB_NAME=hrms
DB_USERNAME=hrms
DB_PASSWORD=Root@123

# Base64 of at least 32 random bytes, e.g.:  openssl rand -base64 48
JWT_SECRET=
JWT_ACCESS_MINUTES=30
JWT_REFRESH_HOURS=8

# Initial System Administrator (created only when no users exist). Change the password after first sign-in.
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@12345
BOOTSTRAP_ADMIN_EMAIL=admin@gmail.com

# Approved CIABOC mail relay (OTP and notifications). When empty, messages are logged and marked SIMULATED.
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=hrms-noreply@ciaboc.gov.lk

# Upload virus scanning (requires: docker compose --profile av up -d)
CLAMAV_ENABLED=false

API_DOCS_ENABLED=false
OTP_DEV_ECHO=false
